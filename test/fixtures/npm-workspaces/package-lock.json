{
  "name": "workspace-repro",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace-repro",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@capsule/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@capsule/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@capsule/extra": {
      "resolved": "packages/extra",
      "link": true
    },
    "node_modules/@capsule/unused": {
      "resolved": "packages/unused",
      "link": true
    },
    "packages/app": {
      "name": "@capsule/app",
      "version": "1.0.0",
      "dependencies": {
        "@capsule/core": "1.0.0"
      }
    },
    "packages/core": {
      "name": "@capsule/core",
      "version": "1.0.0"
    },
    "packages/extra": {
      "name": "@capsule/extra",
      "version": "1.0.0"
    },
    "packages/unused": {
      "name": "@capsule/unused",
      "version": "1.0.0"
    }
  }
}
